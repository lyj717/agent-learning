# 复制这个文件为 .env，然后填入真实值。
# .env 已被 .gitignore 屏蔽，不会被提交。
#
# 用法：
#   copy .env.example .env
#
# 在代码里读取：
#   from dotenv import load_dotenv
#   import os
#   load_dotenv()
#   api_key = os.environ["LLM_API_KEY"]

# 模型服务商的 API Key（OpenAI / DeepSeek / 通义千问 / GLM / Kimi 任选其一）
LLM_API_KEY=在这里填入你的密钥

# 接口地址。换服务商时只改这一行，代码不用动
LLM_BASE_URL=https://api.openai.com/v1

# 默认使用的模型名
LLM_MODEL=gpt-4o-mini

# 可选：调试模式
DEBUG=true
